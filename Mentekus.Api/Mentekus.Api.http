@Mentekus.Api_HostAddress = http://localhost:8080

###
# Liveness. No session cookie is required.

GET {{Mentekus.Api_HostAddress}}/health
# dotnet run (Development, Scalar at /scalar/v1) listens on http://localhost:5277.
# Compose publishes the API on http://localhost:8080 and runs as Production.

# Development does not require X-XSRF-TOKEN. Every other environment does.
# The request below stores the token for the header used on later requests.

###
# Issue the XSRF cookie and read the header value

GET {{Mentekus.Api_HostAddress}}/auth/xsrf

> {%
    client.global.set("xsrf", response.body.token);
%}

###
# Register. Email is unique case-insensitively. No confirmation message is sent.
# Sets the HttpOnly session cookie mentekus.auth.

POST {{Mentekus.Api_HostAddress}}/auth/register
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "name": "Ada Lovelace",
  "email": "ada@example.com",
  "password": "correct horse"
}

###
# Log in (also case-insensitive on email)

POST {{Mentekus.Api_HostAddress}}/auth/login
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "email": "ADA@example.com",
  "password": "correct horse"
}

###
GET {{Mentekus.Api_HostAddress}}/auth/me

###
# Register more users, then log back in as Ada before the calls that act as her

POST {{Mentekus.Api_HostAddress}}/auth/register
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "name": "Grace Hopper",
  "email": "grace@example.com",
  "password": "correct horse"
}

###
POST {{Mentekus.Api_HostAddress}}/auth/login
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "email": "ada@example.com",
  "password": "correct horse"
}

###
# Store a question as the signed-in user. The response id is the question to answer and read.

POST {{Mentekus.Api_HostAddress}}/question/ask
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "question": "What is Native AOT?"
}

> {%
    client.global.set("questionId", response.body.id);
%}

###
POST {{Mentekus.Api_HostAddress}}/question/similarity
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "text": "Tell me about ahead-of-time compilation",
  "limit": 5
}

###
# Answer as the signed-in user. The answer text is stored on the question.
# A zero id returns 404.

POST {{Mentekus.Api_HostAddress}}/question/answer
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "questionId": "{{questionId}}",
  "answer": "Native AOT produces a self-contained executable with no JIT at runtime."
}

###
# Read the question and its answers. A hidden profile omits that person's id and email.

GET {{Mentekus.Api_HostAddress}}/question/{{questionId}}

###
# Ingest a document for the signed-in user. The response is that user's expertise profile.

POST {{Mentekus.Api_HostAddress}}/expertise/document
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "text": "Senior .NET engineer with deep pgvector and Native AOT experience at Acme Corp."
}

###
# Route to experts. AllowRouting must be true. Ranked by hybrid score.

POST {{Mentekus.Api_HostAddress}}/expertise/route
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "query": "native aot pgvector expert",
  "limit": 5
}

###
# Own profile is returned even when ProfileVisible is false.
# Another signed-in user receives 404 for a hidden profile.

GET {{Mentekus.Api_HostAddress}}/user/ada@example.com/expertise

###
# Preferences can be changed only for the signed-in user. The response is the stored flags.

POST {{Mentekus.Api_HostAddress}}/user/ada@example.com/preferences
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "profileVisible": false,
  "allowRouting": true
}

###
# Ends the session. The response body is an empty JSON object.

POST {{Mentekus.Api_HostAddress}}/auth/logout
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

###
